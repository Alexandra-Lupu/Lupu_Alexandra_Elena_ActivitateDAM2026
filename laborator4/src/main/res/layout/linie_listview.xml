<?xml version="1.0" encoding="utf-8"?>
<!-- Lab6: layout-ul pentru UN rand din ListView (imagine in stanga, text in dreapta)
     Adapterul il foloseste de atatea ori cate lacate sunt in lista -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp">

    <!-- imaginea din stanga, aceeasi pentru fiecare lacat -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="70dp"
        android:layout_height="70dp"
        app:srcCompat="@drawable/ic_launcher_background" />

    <!-- textul din dreapta, il completeaza adapterul in getView()-->
    <TextView
        android:id="@+id/lacatTV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:text="TextView" />
</LinearLayout>
